# Copy to .env. Credentials come from the AWS credential chain (profile / SSO), never from here.
# Every setting in config.py must appear here — tests/test_config.py enforces that.
AWS_REGION=eu-west-1

# Bedrock model IDs. A `global.` prefix selects a runtime inference profile; a bare `anthropic.`
# ID selects Mantle, which this account cannot call (CLAUDE.md, Current state). These must match
# infra/terraform/variables.tf or the app role's IAM denies the call.
CHAT_MODEL=global.anthropic.claude-opus-4-6-v1
EXTRACT_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
EMBED_MODEL=

DATABASE_URL=postgresql+asyncpg://art_curator:art_curator@localhost:5432/art_curator

# Ingestion HTTP, shared by sync-graf (P1) and the venue crawler (P2).
GRAF_BASE_URL=https://graf.cat/wp-json/wp/v2
HTTP_USER_AGENT=art-curator/0.1 (+https://github.com/claudio-benfatto/the_art_curator)
HTTP_DELAY_S=0.5
HTTP_TIMEOUT_S=30.0
HTTP_MAX_ATTEMPTS=3

# Optional span export to Langfuse over OTLP. OTel + llm_calls work without it; these key
# defaults match the Compose `langfuse` service's seeded project, not a real secret.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
