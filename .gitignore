# The provider lock file IS committed — omit it from version control and
# `terraform init` silently re-resolves versions, which is what CLAUDE.md #9
# calls drift.
!.terraform.lock.hcl

# Claude Code: settings.json is shared, local overrides are not
.claude/settings.local.json

